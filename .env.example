# Local (.env) and Render (Environment tab) use the same names
# 16+ random characters
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
# 8+ characters (use 12+)
ADMIN_PASSWORD=change-this-password
# Postgres connection string. Required on Render so data survives restarts; leave empty locally (saves to .data/)
DATABASE_URL=
